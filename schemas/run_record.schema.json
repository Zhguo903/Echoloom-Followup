{
  "$defs": {
    "Admission": {
      "enum": [
        "use",
        "do_not_use",
        "ask_permission"
      ],
      "title": "Admission",
      "type": "string"
    },
    "AdmittedMemoryView": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/PublicAction"
        },
        "allowed_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Content"
        },
        "required_qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Required Qualifiers",
          "type": "array"
        },
        "sanitized_permission_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sanitized Permission Topic"
        }
      },
      "required": [
        "memory_id",
        "action"
      ],
      "title": "AdmittedMemoryView",
      "type": "object"
    },
    "ControllerDecision": {
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/PublicAction"
        },
        "allowed_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Content"
        },
        "required_qualifier_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Qualifier Ids",
          "type": "array"
        },
        "sanitized_permission_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sanitized Permission Topic"
        },
        "priority_tier": {
          "$ref": "#/$defs/PriorityTier",
          "default": "optional"
        },
        "override_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Override Reasons",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "action"
      ],
      "title": "ControllerDecision",
      "type": "object"
    },
    "DeliberationBundle": {
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DeliberationDecision"
          },
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "decisions"
      ],
      "title": "DeliberationBundle",
      "type": "object"
    },
    "DeliberationDecision": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "utility": {
          "$ref": "#/$defs/Utility"
        },
        "warrant": {
          "$ref": "#/$defs/Warrant"
        },
        "scope_status": {
          "$ref": "#/$defs/ScopeStatus"
        },
        "admission": {
          "$ref": "#/$defs/Admission"
        },
        "allowed_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Content"
        },
        "preserved_qualifier_ids": {
          "items": {
            "type": "string"
          },
          "title": "Preserved Qualifier Ids",
          "type": "array"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "expression": {
          "$ref": "#/$defs/Expression"
        },
        "priority_tier": {
          "$ref": "#/$defs/PriorityTier"
        },
        "sanitized_permission_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sanitized Permission Topic"
        },
        "brief_rationale": {
          "maxLength": 320,
          "title": "Brief Rationale",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "utility",
        "warrant",
        "scope_status",
        "admission",
        "sensitivity",
        "expression",
        "priority_tier",
        "brief_rationale"
      ],
      "title": "DeliberationDecision",
      "type": "object"
    },
    "Expression": {
      "enum": [
        "none",
        "implicit",
        "explicit",
        "ask_first"
      ],
      "title": "Expression",
      "type": "string"
    },
    "GateBundle": {
      "properties": {
        "results": {
          "items": {
            "$ref": "#/$defs/GateResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "title": "GateBundle",
      "type": "object"
    },
    "GateResult": {
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "eligible_for_deliberation": {
          "title": "Eligible For Deliberation",
          "type": "boolean"
        },
        "direct_use_allowed": {
          "title": "Direct Use Allowed",
          "type": "boolean"
        },
        "permission_only": {
          "title": "Permission Only",
          "type": "boolean"
        },
        "rejected": {
          "title": "Rejected",
          "type": "boolean"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "sanitized_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sanitized Topic"
        }
      },
      "required": [
        "memory_id",
        "eligible_for_deliberation",
        "direct_use_allowed",
        "permission_only",
        "rejected"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "MethodName": {
      "enum": [
        "no_memory",
        "similarity_top_k",
        "one_pass_selective",
        "relevance_two_pass",
        "reconsider_lite",
        "no_physical_separation"
      ],
      "title": "MethodName",
      "type": "string"
    },
    "PriorityTier": {
      "enum": [
        "optional",
        "material",
        "essential"
      ],
      "title": "PriorityTier",
      "type": "string"
    },
    "PublicAction": {
      "enum": [
        "ignore",
        "scoped_implicit",
        "scoped_explicit",
        "ask_first"
      ],
      "title": "PublicAction",
      "type": "string"
    },
    "ScopeStatus": {
      "enum": [
        "invalid",
        "narrowed",
        "intact"
      ],
      "title": "ScopeStatus",
      "type": "string"
    },
    "Sensitivity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "StageLatency": {
      "properties": {
        "gates_ms": {
          "default": 0,
          "title": "Gates Ms",
          "type": "number"
        },
        "deliberation_ms": {
          "default": 0,
          "title": "Deliberation Ms",
          "type": "number"
        },
        "generation_ms": {
          "default": 0,
          "title": "Generation Ms",
          "type": "number"
        },
        "validation_ms": {
          "default": 0,
          "title": "Validation Ms",
          "type": "number"
        }
      },
      "title": "StageLatency",
      "type": "object"
    },
    "Utility": {
      "enum": [
        "none",
        "weak",
        "material",
        "essential"
      ],
      "title": "Utility",
      "type": "string"
    },
    "ValidatorIssue": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidatorIssue",
      "type": "object"
    },
    "Warrant": {
      "enum": [
        "absent",
        "weak",
        "present",
        "strong"
      ],
      "title": "Warrant",
      "type": "string"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "campaign_id": {
      "default": "adhoc",
      "title": "Campaign Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "title": "Scenario Version",
      "type": "integer"
    },
    "method": {
      "$ref": "#/$defs/MethodName"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "prompt_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Versions",
      "type": "object"
    },
    "prompt_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Hashes",
      "type": "object"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "candidate_order": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Order",
      "type": "array"
    },
    "hard_gates": {
      "$ref": "#/$defs/GateBundle"
    },
    "deliberation": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliberationBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_decisions": {
      "items": {
        "$ref": "#/$defs/ControllerDecision"
      },
      "title": "Controller Decisions",
      "type": "array"
    },
    "admitted_views": {
      "items": {
        "$ref": "#/$defs/AdmittedMemoryView"
      },
      "title": "Admitted Views",
      "type": "array"
    },
    "visible_reply": {
      "title": "Visible Reply",
      "type": "string"
    },
    "actions": {
      "additionalProperties": {
        "$ref": "#/$defs/PublicAction"
      },
      "title": "Actions",
      "type": "object"
    },
    "validator_issues": {
      "items": {
        "$ref": "#/$defs/ValidatorIssue"
      },
      "title": "Validator Issues",
      "type": "array"
    },
    "repair_count": {
      "default": 0,
      "title": "Repair Count",
      "type": "integer"
    },
    "fallback_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Type"
    },
    "latency": {
      "$ref": "#/$defs/StageLatency"
    },
    "token_usage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Token Usage",
      "type": "object"
    },
    "configured_cost_estimate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configured Cost Estimate"
    },
    "schema_valid": {
      "default": true,
      "title": "Schema Valid",
      "type": "boolean"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "output_hash": {
      "title": "Output Hash",
      "type": "string"
    },
    "generator_request_json": {
      "title": "Generator Request Json",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "software_commit_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Software Commit Hash"
    },
    "extra": {
      "additionalProperties": true,
      "title": "Extra",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "scenario_version",
    "method",
    "provider",
    "model_id",
    "config_hash",
    "random_seed",
    "candidate_order",
    "hard_gates",
    "visible_reply",
    "input_hash",
    "output_hash",
    "generator_request_json"
  ],
  "title": "RunRecord",
  "type": "object"
}
