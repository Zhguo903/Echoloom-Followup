{
  "$defs": {
    "AuthorExpectations": {
      "additionalProperties": false,
      "description": "Provisional researcher hypotheses, never participant or model truth.",
      "properties": {
        "status": {
          "const": "provisional_design_hypothesis",
          "default": "provisional_design_hypothesis",
          "title": "Status",
          "type": "string"
        },
        "focal_memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focal Memory Id"
        },
        "beneficial_memory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Beneficial Memory Ids",
          "type": "array"
        },
        "harmful_or_forbidden_memory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Harmful Or Forbidden Memory Ids",
          "type": "array"
        },
        "acceptable_actions_by_memory": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/PublicAction"
            },
            "type": "array"
          },
          "title": "Acceptable Actions By Memory",
          "type": "object"
        },
        "required_qualifiers": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Required Qualifiers",
          "type": "object"
        },
        "expected_failure_tags": {
          "items": {
            "type": "string"
          },
          "title": "Expected Failure Tags",
          "type": "array"
        },
        "canary_terms": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Canary Terms",
          "type": "object"
        },
        "rationale": {
          "default": "Provisional synthetic design hypothesis; not a human judgment.",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "acceptable_actions_by_memory"
      ],
      "title": "AuthorExpectations",
      "type": "object"
    },
    "CallbackEvent": {
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "explicit": {
          "default": false,
          "title": "Explicit",
          "type": "boolean"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "CallbackEvent",
      "type": "object"
    },
    "CurrentnessState": {
      "enum": [
        "current",
        "superseded",
        "contradicted",
        "uncertain"
      ],
      "title": "CurrentnessState",
      "type": "string"
    },
    "DialogueTurn": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "DialogueTurn",
      "type": "object"
    },
    "MemoryCard": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "owner_id": {
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Character Id"
        },
        "content": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemorySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "permission_state": {
          "$ref": "#/$defs/PermissionState"
        },
        "currentness": {
          "$ref": "#/$defs/CurrentnessState"
        },
        "supersedes_memory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes Memory Ids",
          "type": "array"
        },
        "superseded_by_memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By Memory Id"
        },
        "confirmed_by_user": {
          "default": true,
          "title": "Confirmed By User",
          "type": "boolean"
        },
        "is_model_inference": {
          "default": false,
          "title": "Is Model Inference",
          "type": "boolean"
        },
        "recent_callback_count": {
          "default": 0,
          "minimum": 0,
          "title": "Recent Callback Count",
          "type": "integer"
        },
        "last_callback_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Callback At"
        },
        "narrative_branch": {
          "default": "main",
          "minLength": 1,
          "title": "Narrative Branch",
          "type": "string"
        },
        "scope_qualifiers": {
          "items": {
            "$ref": "#/$defs/ScopeQualifier"
          },
          "title": "Scope Qualifiers",
          "type": "array"
        },
        "sanitized_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sanitized Topic"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "owner_id",
        "content",
        "memory_type",
        "created_at",
        "source",
        "confidence",
        "sensitivity",
        "permission_state",
        "currentness"
      ],
      "title": "MemoryCard",
      "type": "object"
    },
    "MemorySource": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "speaker": {
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_id",
        "speaker",
        "captured_at"
      ],
      "title": "MemorySource",
      "type": "object"
    },
    "MemoryType": {
      "enum": [
        "personal_fact",
        "stable_preference",
        "episodic_experience",
        "shared_relational_experience",
        "relationship_state",
        "milestone",
        "sensitive_history",
        "unresolved_issue",
        "corrected_state",
        "alternate_context",
        "model_inference"
      ],
      "title": "MemoryType",
      "type": "string"
    },
    "ParticipantProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "description"
      ],
      "title": "ParticipantProfile",
      "type": "object"
    },
    "PermissionState": {
      "enum": [
        "allowed",
        "ask_before_use",
        "forbidden",
        "deleted"
      ],
      "title": "PermissionState",
      "type": "string"
    },
    "PublicAction": {
      "enum": [
        "ignore",
        "scoped_implicit",
        "scoped_explicit",
        "ask_first"
      ],
      "title": "PublicAction",
      "type": "string"
    },
    "ScenarioConversation": {
      "additionalProperties": false,
      "description": "Conversation fields stored in schema v2, without duplicated candidate cards.",
      "properties": {
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "owner_id": {
          "title": "Owner Id",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "active_branch": {
          "default": "main",
          "title": "Active Branch",
          "type": "string"
        },
        "current_message": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Current Message",
          "type": "string"
        },
        "recent_turns": {
          "items": {
            "$ref": "#/$defs/DialogueTurn"
          },
          "maxItems": 20,
          "title": "Recent Turns",
          "type": "array"
        },
        "callback_history": {
          "items": {
            "$ref": "#/$defs/CallbackEvent"
          },
          "title": "Callback History",
          "type": "array"
        }
      },
      "required": [
        "conversation_id",
        "owner_id",
        "character_id",
        "current_message"
      ],
      "title": "ScenarioConversation",
      "type": "object"
    },
    "ScenarioNotes": {
      "additionalProperties": false,
      "properties": {
        "claim_status": {
          "default": "design_hypothesis",
          "title": "Claim Status",
          "type": "string"
        },
        "reviewer_notes": {
          "default": "",
          "title": "Reviewer Notes",
          "type": "string"
        }
      },
      "title": "ScenarioNotes",
      "type": "object"
    },
    "ScenarioReviewMetadata": {
      "additionalProperties": false,
      "properties": {
        "generated_by": {
          "title": "Generated By",
          "type": "string"
        },
        "content_review_status": {
          "default": "needs_human_review",
          "enum": [
            "needs_human_review",
            "human_reviewed"
          ],
          "title": "Content Review Status",
          "type": "string"
        },
        "research_review_status": {
          "default": "needs_human_review",
          "enum": [
            "needs_human_review",
            "human_reviewed"
          ],
          "title": "Research Review Status",
          "type": "string"
        },
        "reviewed_by": {
          "items": {
            "type": "string"
          },
          "title": "Reviewed By",
          "type": "array"
        },
        "review_notes": {
          "items": {
            "type": "string"
          },
          "title": "Review Notes",
          "type": "array"
        }
      },
      "required": [
        "generated_by"
      ],
      "title": "ScenarioReviewMetadata",
      "type": "object"
    },
    "ScopeQualifier": {
      "additionalProperties": false,
      "properties": {
        "qualifier_id": {
          "minLength": 1,
          "title": "Qualifier Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "required_if_used": {
          "default": true,
          "title": "Required If Used",
          "type": "boolean"
        }
      },
      "required": [
        "qualifier_id",
        "kind",
        "text"
      ],
      "title": "ScopeQualifier",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SeparationStressMetadata": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "rejected_memory_id": {
          "title": "Rejected Memory Id",
          "type": "string"
        },
        "exact_canary": {
          "title": "Exact Canary",
          "type": "string"
        },
        "semantic_concept": {
          "title": "Semantic Concept",
          "type": "string"
        },
        "expected_admitted_memory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expected Admitted Memory Ids",
          "type": "array"
        },
        "no_memory_path_is_valid": {
          "default": true,
          "title": "No Memory Path Is Valid",
          "type": "boolean"
        },
        "required_checks": {
          "items": {
            "enum": [
              "exact_canary",
              "lexical_overlap",
              "blinded_semantic"
            ],
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        },
        "blinded_semantic_judge_input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blinded Semantic Judge Input"
        }
      },
      "required": [
        "category",
        "rejected_memory_id",
        "exact_canary",
        "semantic_concept",
        "required_checks"
      ],
      "title": "SeparationStressMetadata",
      "type": "object"
    },
    "StudyAScenarioMetadata": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "default": false,
          "title": "Eligible",
          "type": "boolean"
        },
        "target_memory_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Memory Ids",
          "type": "array"
        },
        "participant_context_translation_status": {
          "default": "not_started",
          "enum": [
            "not_started",
            "draft",
            "needs_human_review",
            "human_reviewed"
          ],
          "title": "Participant Context Translation Status",
          "type": "string"
        }
      },
      "title": "StudyAScenarioMetadata",
      "type": "object"
    },
    "StudyBScenarioMetadata": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "default": false,
          "title": "Eligible",
          "type": "boolean"
        },
        "participant_context_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Context Version"
        }
      },
      "title": "StudyBScenarioMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical scenario v2 model with a compatibility loader for v1 files.",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "family_id": {
      "title": "Family Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "set_name": {
      "title": "Set Name",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed",
        "frozen"
      ],
      "title": "Status",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "focal_action_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "participant_profile": {
      "$ref": "#/$defs/ParticipantProfile"
    },
    "conversation": {
      "$ref": "#/$defs/ScenarioConversation"
    },
    "candidate_memories": {
      "items": {
        "$ref": "#/$defs/MemoryCard"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Candidate Memories",
      "type": "array"
    },
    "study_a": {
      "$ref": "#/$defs/StudyAScenarioMetadata"
    },
    "study_b": {
      "$ref": "#/$defs/StudyBScenarioMetadata"
    },
    "author_expectations": {
      "$ref": "#/$defs/AuthorExpectations"
    },
    "review": {
      "$ref": "#/$defs/ScenarioReviewMetadata"
    },
    "separation_stress": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeparationStressMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "$ref": "#/$defs/ScenarioNotes"
    }
  },
  "required": [
    "scenario_id",
    "family_id",
    "version",
    "title",
    "set_name",
    "domain",
    "participant_profile",
    "conversation",
    "candidate_memories",
    "author_expectations",
    "review"
  ],
  "title": "Scenario",
  "type": "object"
}
